import asyncio
from deriv_api import DerivAPI
import collections
import sys

# --- CONFIGURAÇÕES ---
TOKEN = 'jnzxOPNPNolDHe0'
APP_ID = '1089'
ATIVO = 'R_100'
STAKE_INICIAL = 2.0
MIN_GAP = 45 # Aumentado para maior segurança em vácuos longos

class SniperV91:
    def __init__(self):
        self.api = None
        self.historico = collections.deque(maxlen=100)
        self.ultimo_aparecimento = {i: 0 for i in range(10)}
        self.tick_contador = 0
        self.ultimo_tick_operado = 0 # TRAVA CRÍTICA
        self.stake_atual = STAKE_INICIAL
        self.lucro_total = 0.0

    async def conectar(self):
        try:
            self.api = DerivAPI(app_id=APP_ID)
            await self.api.authorize(TOKEN)
            print(f"🏛️ SNIPER V91 - ANTI-SPAM SYSTEM")
            return True
        except: return False

    async def iniciar(self):
        if not await self.conectar(): return
        
        sub = await self.api.subscribe({'ticks': ATIVO})
        
        def processar_tick(m):
            if 'tick' in m:
                digito = int(str(m['tick']['quote'])[-1])
                self.historico.append(digito)
                self.tick_contador += 1
                self.ultimo_aparecimento[digito] = self.tick_contador

        sub.subscribe(processar_tick)

        while True:
            try:
                # Só analisa se o contador de ticks mudou desde a última operação
                if len(self.historico) < 100 or self.tick_contador <= self.ultimo_tick_operado:
                    await asyncio.sleep(0.1)
                    continue

                # Calcula o GAP
                maior_gap = 0
                digito_alvo = 0
                for d in range(10):
                    gap = self.tick_contador - self.ultimo_aparecimento[d]
                    if gap > maior_gap:
                        maior_gap = gap
                        digito_alvo = d

                sys.stdout.write(f"\r📊 Ticks: {self.tick_contador} | Alvo: {digito_alvo} | GAP: {maior_gap} | Saldo: ${self.lucro_total:.2f} ")
                sys.stdout.flush()

                if maior_gap >= MIN_GAP:
                    self.ultimo_tick_operado = self.tick_contador # TRAVA O TICK ATUAL
                    print(f"\n🔥 GATILHO! Alvo {digito_alvo} (GAP {maior_gap}). Stake: ${self.stake_atual}")
                    
                    buy = await self.api.buy({
                        "buy": 1, "price": self.stake_atual,
                        "parameters": {
                            "amount": self.stake_atual, "basis": "stake",
                            "contract_type": "DIGITMATCH", "currency": "USD",
                            "symbol": ATIVO, "duration": 1, "duration_unit": "t",
                            "barrier": str(digito_alvo)
                        }
                    })

                    if 'buy' in buy:
                        await asyncio.sleep(4) # Tempo para a Deriv fechar o contrato
                        st = await self.api.statement({"limit": 1, "action_type": "buy"})
                        res_val = float(st['statement']['transactions'][0]['amount'])
                        self.lucro_total += res_val

                        if res_val > 0:
                            print(f"💎 WIN! +${res_val:.2f}")
                            self.stake_atual = STAKE_INICIAL
                        else:
                            self.stake_atual = round(self.stake_atual * 1.15, 2)
                            print(f"💀 LOSS. Próxima stake: ${self.stake_atual}")
                        
                        # Após operar, esperamos o mercado se mover para "limpar" o gap na nossa lógica
                        print("⏳ Aguardando novos ticks para reanalisar...")
                        self.ultimo_tick_operado = self.tick_contador + 5 # Só libera após +5 ticks
                
                await asyncio.sleep(0.2)
            except Exception as e:
                await asyncio.sleep(1)

if __name__ == "__main__":
    asyncio.run(SniperV91().iniciar())
